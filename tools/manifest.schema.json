{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/qeasy-cloud/datahub-mcp-ops/tools/manifest.schema.json",
  "title": "Datahub MCP tool manifest",
  "description": "Machine-readable snapshot of the tools a Datahub MCP server exposes. Generated by `python scripts/dh.py manifest`; consumed by docs CI and client-side capability checks.",
  "type": "object",
  "required": [
    "schema_version",
    "server",
    "server_version",
    "capability_version",
    "generated_at",
    "tool_count",
    "business_tool_count",
    "tools"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "server": { "type": "string", "minLength": 1 },
    "server_version": { "type": "string" },
    "capability_version": {
      "type": "string",
      "description": "Server-side capability version (x-capability-version). Clients use it to decide whether to re-read this manifest."
    },
    "generated_at": { "type": "string", "minLength": 10 },
    "tool_count": {
      "type": "integer",
      "minimum": 1,
      "description": "Total tools including meta.*"
    },
    "business_tool_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Tools excluding meta.*"
    },
    "meta_tools": {
      "type": "array",
      "description": "Optional: meta tools when the generator enumerates them separately.",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "pattern": "^meta\\." },
          "scope": { "type": ["string", "null"] },
          "risk": { "type": "string" }
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "risk", "description", "properties"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$",
            "description": "domain.object.action, e.g. strategy.queue.job.run"
          },
          "title": { "type": ["string", "null"] },
          "scope": {
            "type": ["string", "null"],
            "pattern": "^[a-z]+:[a-z]+$",
            "description": "Required scope, e.g. strategy:read"
          },
          "risk": {
            "type": "string",
            "enum": ["read", "write", "ops", "destructive"]
          },
          "requires_confirmation": { "type": ["boolean", "null"] },
          "description": { "type": "string", "minLength": 5 },
          "required": {
            "type": "array",
            "items": { "type": "string" }
          },
          "properties": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Parameter names only; schemas live on the server."
          }
        }
      }
    }
  }
}
